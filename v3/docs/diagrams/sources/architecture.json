  "cards": [
    {
      "dot": "cyan",
      "title": "Two processes",
      "items": [
        "Flutter shell owns the window and UI",
        "seal-core.exe owns config, tools, capture and board I/O"
      ]
    },
    {
      "dot": "amber",
      "title": "One decision path",
      "items": [
        "seal-domain returns decisions",
        "seal-tools/runner turns them into effects",
        "seal-win supplies reads and foreground checks"
      ]
    },
    {
      "dot": "rose",
      "title": "One input owner",
      "items": [
        "The supervisor serialises starts and stops",
        "seal-board is the only path to the Arduino"
      ]
    }
