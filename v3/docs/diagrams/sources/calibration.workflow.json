  "cards": [
    {
      "dot": "cyan",
      "title": "One capture bar",
      "items": [
        "Hide the shell, wait for the composited hide, capture, show again",
        "Screens are session state; a saved mark stores no frame id"
      ]
    },
    {
      "dot": "amber",
      "title": "Validation is kind-specific",
      "items": [
        "Bag slot must agree with the bag grid pitch",
        "Gem result asks empty / not empty; Tooltip saves the hover offset",
        "Tuner derives region/bands from three boxes"
      ]
    },
    {
      "dot": "rose",
      "title": "Save is one write gate",
      "items": [
        "A refusal writes nothing and consumes no revision",
        "Display environment and measured_at are stamped",
        "Deleting a screen needs two confirmations and never touches saved marks"
      ]
    }
