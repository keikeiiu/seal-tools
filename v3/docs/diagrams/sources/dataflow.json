  "cards": [
    {
      "dot": "cyan",
      "title": "Three config classes",
      "items": [
        "Shipped defaults are the static base",
        "setup/ travels between PCs",
        "machine/ is measured and regenerable"
      ]
    },
    {
      "dot": "amber",
      "title": "One merge, many readers",
      "items": [
        "The core serves one merged JSON view",
        "Shell and tools never read the files directly"
      ]
    },
    {
      "dot": "rose",
      "title": "One write gate",
      "items": [
        "The caller names what changed, never a whole file",
        "Each field routes to its owning file",
        "config.changed arrives after the response"
      ]
    }
