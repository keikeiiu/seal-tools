  "cards": [
    {
      "dot": "violet",
      "title": "Plan, then effects",
      "items": [
        "seal-domain builds each turn as GemTurn step lists",
        "seal-core drains them as place, click and wait decisions"
      ]
    },
    {
      "dot": "rose",
      "title": "The streak gate",
      "items": [
        "One empty read never advances a grade",
        "empty_mode: stop never reads, so the grade never changes"
      ]
    },
    {
      "dot": "amber",
      "title": "Refuse before clicking",
      "items": [
        "An unknown route or uncalibrated point stops the turn",
        "Grade dots and resource slots use the same refusal"
      ]
    }
