  "cards": [
    {
      "dot": "amber",
      "title": "Decision vs effects",
      "items": [
        "seal-domain returns Retry or Stop(reason) — never an input",
        "seal-core turns that answer into clicks, keys and captures"
      ]
    },
    {
      "dot": "rose",
      "title": "Every stop is a line",
      "items": [
        "Match, out of springs, three repeats and the retry budget each carry their own wording",
        "A guard stop names the drift instead of clicking on"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reads must confirm",
      "items": [
        "A partial read is re-captured up to tuner.ocr_retries",
        "An unconfirmed read stops rather than counting as a repeat"
      ]
    }
  ]
