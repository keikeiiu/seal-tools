# ── Secrets — NEVER commit ─────────────────────────────
# Check-in account credentials + saved login sessions.
# Unanchored (no directory prefix) so they stay ignored wherever v1 lives.
checkin_config.yaml
sessions/

# ── Runtime state files ────────────────────────────────
state.json
gem_state.json
spammer_state.json
# v3's dev/install config tree: the core writes v3/config/local.yaml (legacy machine state) and,
# after the portable-layout migration, player state under setup/, machine/, artifacts/ plus user.yaml,
# meta.yaml and the transaction scratch. The seed files beside them are committed; the player's own
# calibration and run state are not.
v3/config/local.yaml
v3/config/local.yaml.backup-*
v3/config/local.yaml.corrupt-backup
v3/config/setup/
v3/config/machine/
v3/config/artifacts/
v3/config/user.yaml
v3/config/meta.yaml
v3/config/.migration-backup-*
v3/config/.seal-txn/
v3/config/.seal-core.lock

# ── Control files ──────────────────────────────────────
control.txt
gem_control.txt
spammer_control.txt
force_check.txt

# ── Logs & captures ────────────────────────────────────
tool_error.log
logs/
captures/
slot_captures/
*.png
*.jpg
*.jpeg
# Documentation screenshots ARE committed — the rule above exists to keep runtime captures and
# calibration images out, and docs/images holds neither. Needs to come after *.png to take effect.
!v2/docs/images/*.png
# OCR regression corpus cases are committed test data, not runtime captures (OCR-F11).
!v3/core/fixtures/ocr/**/*.png

# ── Build artifacts ────────────────────────────────────
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
build/
dist/
*.spec
# Local scratch: cargo homes and throwaway build areas. Never committed.
.scratch/

# ── Reference material (local screenshots/notes — not tracked) ──
reference/

# ── Archify working area ───────────────────────────────
# Diagram candidates, debug captures and delivery receipts are local working
# state. The published diagrams are committed in v2/docs/diagrams/flows/.
.archify/

# ── Misc cruft ─────────────────────────────────────────

# Local Claude Code skills: machine-specific tooling, not project source. DSH instructions
# live in AGENTS.md instead.
.claude/

# v3 dev/install OCR models: large binaries, copied locally; never committed
v3/models/
