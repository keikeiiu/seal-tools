<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Core alone left the tool logic unreachable: AttrMatcher, the composer and the spammer loop
       could not be tested at all, however many tests were written. These three are plain net8.0
       libraries, so they can be referenced directly. The Launcher is net8.0-windows and stays out. -->
  <ItemGroup>
    <ProjectReference Include="..\SealTools.Core\SealTools.Core.csproj" />
    <ProjectReference Include="..\SealTools.Tuner\SealTools.Tuner.csproj" />
    <ProjectReference Include="..\SealTools.Spammer\SealTools.Spammer.csproj" />
    <ProjectReference Include="..\SealTools.GemComposer\SealTools.GemComposer.csproj" />
    <!-- The pet tool, for its ONE public number: PetTool.MatchLimit is the threshold the bag sweep
         stores its candidates with, and the per-use re-score (IconMatch.ScoreCell) must be judged
         against the SAME number — a test carrying its own copy would agree with the tool's run and be
         wrong about it, which is the trap MatchLimit's own comment names. SealTools.Pet is plain
         net8.0, so unlike the Launcher it can be referenced directly. -->
    <ProjectReference Include="..\SealTools.Pet\SealTools.Pet.csproj" />
  </ItemGroup>

</Project>
