                </mxCell>
                <mxCell id="3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" value="1 · choose — the card&#39;s pick first, then the tab&#39;s" vertex="1">
