                <mxCell id="32" parent="30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" value="the run is torn down; the card reads &quot;stopped&quot;&#xa;Finish clears the plan, the Message stays" vertex="1">
