                </mxCell>
                <mxCell id="31" parent="30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" value="a cancel cancels the token — the next sleep THROWS&#xa;or a branch returns Cancelled at once" vertex="1">
