                <mxCell id="11" parent="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" value="4 · tick — sleep ~50 ms&#xa;quit, the cancel token, F12 and F9 are seen here" vertex="1">
