                <mxCell id="5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" value="3 · seed the state&#xa;running=false · cycle=0 · emptyCount=0" vertex="1">
