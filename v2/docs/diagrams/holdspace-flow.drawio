                <mxCell id="18" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#9673a6;whiteSpace=wrap;" value="One of only TWO tools that can leave something held — this one the SPACEBAR, the pet its mouse button. Every stop path must lift it." vertex="1">
                    <mxGeometry height="90" width="320" x="800" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="19" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#9673a6;whiteSpace=wrap;" value="The launcher claims the gate for holdspace at Start; this tool never reads it and never yields — so it blocks the resident pet for as long as it is left on." vertex="1">
