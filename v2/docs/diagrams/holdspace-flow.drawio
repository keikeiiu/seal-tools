                <mxCell id="15" parent="100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" value="6 · F12 edge — the TOGGLE&#xa;on ▓ &quot;P&quot; (down)  ·  off ▓ &quot;U&quot; (lifted)" vertex="1">
