                <mxCell id="13" parent="100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" value="4 · the panel says START&#xa;▓ write &quot;P&quot; — the spacebar goes DOWN" vertex="1">
