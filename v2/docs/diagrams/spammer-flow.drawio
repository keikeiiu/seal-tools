<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Skill Spammer">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Entry -->
        <mxCell id="2" value="Run — handed the port, the card state, and one cancellation token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="370" y="40" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="1 · arm the stop&#xa;give the run's token to the base, so a later sleep THROWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="370" y="130" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="2 · any keys in the active preset?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="370" y="230" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="5" value="✋ nothing runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="790" y="245" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="6" value="3 · plan the run&#xa;combos first, then the singles that stand alone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="370" y="360" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- The loop -->
        <mxCell id="10" value="LOOP — repeats until the run is stopped" style="swimlane;startSize=30;html=1;fillColor=none;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="440" height="660" as="geometry" />
        </mxCell>
        <mxCell id="11" value="4 · tick — sleep ~20 ms&#xa;a QUIT press is seen here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="10">
          <mxGeometry x="90" y="50" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="12" value="5 · stopped?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="10">
          <mxGeometry x="80" y="150" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="13" value="6 · the panel and F12 edges&#xa;apply the run state; F12 is a TOGGLE, never a terminate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="10">
          <mxGeometry x="90" y="280" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" value="7 · THE YIELD&#xa;only when a game claim is wired" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="10">
          <mxGeometry x="80" y="380" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="15" value="8 · ▓ write the due key&#xa;one combo step, or one preempted single" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="10">
          <mxGeometry x="90" y="530" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="16" value="9 · port dead?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="10">
          <mxGeometry x="80" y="630" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- The yield's three states, to the right of the loop -->
        <mxCell id="20" value="holding&#xa;someone waits? ─► release the game&#xa;and name them on the card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="800" y="840" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="21" value="yielded&#xa;claim free? ─► re-acquire and Reset&#xa;(no new lead-in)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="800" y="930" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="22" value="waiting&#xa;still held? ─► press nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="800" y="1020" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- The stop path -->
        <mxCell id="30" value="STOP PATH — however the loop leaves" style="swimlane;startSize=30;html=1;fillColor=none;strokeColor=#b85450;fontStyle=1;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="300" y="1160" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="31" value="a Stop cancels the token ─►&#xa;the loop's next sleep THROWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="30">
          <mxGeometry x="90" y="50" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="32" value="the tool's finally runs&#xa;clears &quot;running&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="30">
          <mxGeometry x="90" y="140" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- Terminals — one per exit, so neither edge has to span the whole loop -->
        <mxCell id="40" value="✋ the run ends&#xa;nothing is left held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="790" y="620" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="41" value="✋ the run ends&#xa;nothing is left held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="790" y="1100" width="200" height="70" as="geometry" />
        </mxCell>

