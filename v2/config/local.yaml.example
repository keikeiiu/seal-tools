# Seal Tools v2 — machine-specific calibration (copy to local.yaml, then adjust).
# local.yaml is gitignored. Values here are the v1 measured values as a starting point
# for the first-run seed; they WILL be off until you run the calibrator and hit Save.
#
# NOTE on coordinate origin: the `tuner.ocr` region/sub-bands below are v1 WINDOW-relative
# (measured from the window's top-left INCLUDING the title bar), but v2 captures are
# CLIENT-area-relative (origin = the game window's client top-left, no title bar). So the
# seeded geometry is shifted down by the title-bar height until you recalibrate in-app.
# Same applies to `gem.grade_positions`, which are absolute SCREEN coordinates — re-measure.

tuner:
  ocr:
    region: {left: 1140, top: 840, width: 300, height: 320}
    grade_area: {x1: 149, y1: 1, x2: 232, y2: 44}
    grade_y: [1, 44]
    attr_y: [42, 140]
    remaining_y: [190, 235]
    row_height: 25

gem:
  grade_positions:
    N: [727, 696]
    G: [777, 696]
    DG: [827, 696]
    Register: [835, 724]
    Combine: [785, 871]
  resource_gems:              # 3 click points, one per composer slot (remove a stuck gem)
    - [450, 696]
    - [520, 696]
    - [590, 696]
  result_gem_area: [610, 800, 220, 60]   # composed-result area [x, y, w, h]; OCR + centre click
  # empty_signature is filled in automatically by the gem calibrator (it samples the result
  # box while EMPTY). Leave unset — empty detection stays off until you calibrate. Format:
  # {mean_v: 0.3, mean_sat: 0.1, colored_fraction: 0.05, mean_r: 0.3, mean_g: 0.3, mean_b: 0.3}
  # Pointer scale: client-pixels the in-game pointer moves per 100 HID counts, per axis [x, y].
  # 100,100 = 1:1. All relative "D" moves are computed as (point - Register) * scale / 100, so
  # NO movement is hand-tuned. Measure once via "Probe scale" in the Gem calibrate tab (with the
  # Windows 'Enhance pointer precision' checkbox OFF and the pointer notch fixed), then enter the
  # pixels per 100 counts for X and Y. These examples are v1 starting points; re-measure.
  mouse_scale: [100, 100]

arduino:
  port: ""   # optional override; empty = auto-detect

display:
  dpi_scale: null   # optional manual DPI scale override; null = auto-detect via GetDpiForWindow
