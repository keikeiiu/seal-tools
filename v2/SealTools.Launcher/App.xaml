<Application x:Class="SealTools.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- No palette of our own: the UI uses WPF-UI's semantic theme brushes directly
                 (TextFillColorPrimary/Secondary, SystemFillColorSuccess/Critical/Caution,
                 CardBackgroundFillColorDefault, ApplicationBackground). One palette, and the
                 theme switch in the merged ThemesDictionary actually governs the app. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
